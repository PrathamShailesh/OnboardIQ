# Database Configuration
# For local development with SQLite (default):
# DATABASE_URL=sqlite:///./onboardiq.db

# For production with PostgreSQL (Render.com provides this automatically):
# DATABASE_URL=postgresql://user:password@host:port/database

# Authentication Secret Key
# Generate a secure random string for production deployment
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=development-only-secret-change-before-deploy

# CORS Origins
# Comma-separated list of allowed frontend URLs
# For production: https://your-frontend-domain.com
# For local development: http://localhost:3000,http://localhost:3001
# For Render deployment with separate frontend: https://your-app.onrender.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Environment
ENVIRONMENT=development
